# Normalize text files in the repository to LF on every platform.
* text eol=lf
*.gitattributes text eol=lf
*.editorconfig text eol=lf
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.csv text eol=lf

# Keep generated and binary files out of text conversion.
*.pdf binary
*.h5 binary
*.keras binary
*.ckpt binary
*.ckpt.* binary
